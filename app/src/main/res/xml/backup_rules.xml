<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
  <!-- Defence-in-depth: allowBackup=false disables normal app backup, but keep explicit excludes so future manifest changes do not silently include Bluetooth/TS18 data. -->
  <exclude domain="sharedpref" path="."/>
  <exclude domain="file" path="."/>
  <exclude domain="database" path="."/>
  <exclude domain="external" path="."/>
</full-backup-content>
